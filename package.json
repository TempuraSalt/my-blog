{
  "name": "my-blog",
  "version": "1.0.0",
  "description": "Personal blog with automated post generation",
  "main": "generate_posts_json.js",
  "scripts": {
    "test": "mocha test/**/*.test.js",
    "test:watch": "mocha test/**/*.test.js --watch",
    "lint": "eslint *.js lib/**/*.js scripts/**/*.js",
    "generate": "node generate_posts_json.js",
